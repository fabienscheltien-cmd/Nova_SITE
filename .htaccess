# =====================================================================
# nova-serenity.fr : configuration Apache (hébergement OVH)
# =====================================================================
AddDefaultCharset UTF-8
AddType text/plain;charset=UTF-8 .txt
AddType application/manifest+json .webmanifest
Options -Indexes
DirectoryIndex nova-serenity-with-intro-video1.html index.html
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
RewriteEngine On

# HTTPS et www obligatoires (une seule URL canonique)
RewriteCond %{SERVER_PORT} 80 [OR]
RewriteCond %{HTTP_HOST} !^www\. [NC]
RewriteRule ^(.*)$ https://www.nova-serenity.fr/$1 [R=301,L]

# /blog/index.html -> /blog/  (la page d'accueil est nova-serenity-with-intro-video1.html, servie aussi à la racine)
RewriteCond %{THE_REQUEST} \s/+(.*/)?index\.html[\s?] [NC]
RewriteRule ^(.*/)?index\.html$ /$1 [R=301,L]

# Page d'accueil : une seule URL (/), l'ancien nom de fichier redirige
RewriteCond %{THE_REQUEST} \s/+nova-serenity-with-intro-video1\.html[\s?] [NC]
RewriteRule ^nova-serenity-with-intro-video1\.html$ / [R=301,L]

# /blog -> /blog/
RewriteRule ^blog$ /blog/ [R=301,L]
</IfModule>

# Anciennes URL
Redirect 301 /blog/conciergerie-services-2025.html https://www.nova-serenity.fr/blog/conciergerie-services-2026.html
Redirect 301 /nova-store_2509.html https://www.nova-serenity.fr/nova-store.html

# Compression
<IfModule mod_deflate.c>
AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml application/xml application/javascript application/json application/ld+json image/svg+xml application/manifest+json
</IfModule>

# Cache navigateur
<IfModule mod_expires.c>
ExpiresActive On
ExpiresDefault "access plus 1 week"
ExpiresByType text/html "access plus 0 seconds"
ExpiresByType text/plain "access plus 1 day"
ExpiresByType application/xml "access plus 1 day"
ExpiresByType image/jpeg "access plus 1 year"
ExpiresByType image/png "access plus 1 year"
ExpiresByType image/webp "access plus 1 year"
ExpiresByType image/svg+xml "access plus 1 year"
ExpiresByType image/x-icon "access plus 1 year"
ExpiresByType image/vnd.microsoft.icon "access plus 1 year"
ExpiresByType video/mp4 "access plus 1 month"
</IfModule>

# En-têtes de sécurité
<IfModule mod_headers.c>
Header always set X-Content-Type-Options "nosniff"
Header always set Referrer-Policy "strict-origin-when-cross-origin"
Header always set X-Frame-Options "SAMEORIGIN"
Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
</IfModule>

# Ancienne adresse de la page des jeux
Redirect 301 /games.html https://www.nova-serenity.fr/play.html
